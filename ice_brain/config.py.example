# ============================================================================
# ICE BRAIN - Konfiguration
# ============================================================================
# Kopiere diese Datei als config.py und passe die Werte an:
#   cp config.py.example config.py

# ============================================================================
# Modell-Konfiguration
# ============================================================================
# Zwei Varianten stehen zur Auswahl:
#
#   1. Non-Thinking (Standard, empfohlen)
#      Qwen2.5-Instruct – schnelle Antworten, kein <think>-Overhead,
#      weniger GPU-Last, volles Token-Budget für die eigentliche Antwort.
#      Router + Memory-Extraction brauchen ohnehin nur strukturiertes JSON,
#      kein internes Reasoning.
#
#   2. Thinking (auskommentiert)
#      Qwen3 – generiert intern einen <think>…</think>-Reasoning-Block vor
#      jeder Antwort. Kann bei komplexen logischen Aufgaben bessere Ergebnisse
#      liefern, kostet aber deutlich mehr Latenz und Tokens.
#      Der Server filtert den Think-Block automatisch heraus (strip_thinking=True).
#
# Du kannst Router und Main unabhängig mischen – z.B. Non-Thinking-Router
# (schnelle Klassifikation) + Thinking-Main (falls du die Qualität brauchst).
# Einfach die gewünschten Blöcke einkommentieren.
#
# 'chat_format' – Nur setzen wenn Auto-Detection fehlschlägt!
#   Qwen-Modelle:   nicht nötig (auto-detected als 'chatml')
#   Llama-Modelle:  'llama-3'
#   Mistral-Modelle: 'mistral-instruct'
#   Wenn das Modell Endlosschleifen produziert → chat_format ist falsch.

MODELS = {
    # ── Router-Modell (Intent-Klassifikation, läuft auf P4) ──────────────
    # Non-Thinking (empfohlen – reicht für JSON-Klassifikation, spart VRAM auf P4)
    # ~2 GB VRAM
    'router': {
        'path': '/models/Qwen2.5-3B-Instruct-Q4_K_M.gguf',
        'hf_repo': 'bartowski/Qwen2.5-3B-Instruct-GGUF',
        'hf_file': 'Qwen2.5-3B-Instruct-Q4_K_M.gguf',
        'gpu': 1,            # GPU-Index: 1 = P4
        'n_ctx': 4096,
        'n_gpu_layers': -1,  # -1 = alle Layer auf GPU
    },
    # Thinking-Alternative für Router (auskommentieren zum Aktivieren):
