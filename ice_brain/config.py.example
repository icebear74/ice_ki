# ============================================================================
# MySQL / MariaDB-Konfiguration
# ============================================================================
MYSQL = {
    'host': 'localhost',
    'port': 3306,
    'user': 'ice_brain',
    'password': 'CHANGE_ME',
    'database': 'ice_brain',
    'pool_size': 5,
