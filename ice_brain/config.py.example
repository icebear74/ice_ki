# ============================================================================
# ICE BRAIN - Konfiguration
# ============================================================================
# Kopiere diese Datei als config.py und passe die Werte an:
#   cp config.py.example config.py

# Modell-Konfiguration
# hf_repo / hf_file: Falls das Modell unter 'path' fehlt, wird es automatisch
# von HuggingFace heruntergeladen (huggingface-hub muss installiert sein).
MODELS = {
    'router': {
        'path': '/models/Qwen3-4B-Q4_K_M.gguf',
        'hf_repo': 'bartowski/Qwen_Qwen3-4B-GGUF',
        'hf_file': 'Qwen3-4B-Q4_K_M.gguf',
        'gpu': 1,            # GPU-Index: 1=P4
        'n_ctx': 4096,
        'n_gpu_layers': -1,  # -1 = alle Layer auf GPU
    },
    'main': {
        'path': '/models/Qwen3-8B-Q4_K_M.gguf',
        'hf_repo': 'bartowski/Qwen_Qwen3-8B-GGUF',
        'hf_file': 'Qwen3-8B-Q4_K_M.gguf',
        'gpu': 0,            # GPU-Index: 0=P100
        'n_ctx': 8192,
        'n_gpu_layers': -1,
    },
}

# MySQL-Konfiguration
MYSQL = {
    'host': 'localhost',
    'port': 3306,
    'user': 'ice_brain',
    'password': 'CHANGE_ME',
    'database': 'ice_brain',
    'pool_size': 5,
}

# Server-Konfiguration
HOST = '0.0.0.0'
PORT = 8000

# Admin-Benutzername, der beim Systemstart automatisch angelegt wird (falls noch kein Admin existiert)
ADMIN_USER = 'admin'

# Embedding-Modell (für spätere Vektorsuche — Phase 2+)
EMBEDDING_MODEL = {
    'path': '/models/nomic-embed-text-v1.5.Q4_K_M.gguf',
    'gpu': 1,  # P4
}
