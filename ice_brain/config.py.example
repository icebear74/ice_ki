# ============================================================================
# ICE BRAIN - Konfiguration
# ============================================================================
# Kopiere diese Datei als config.py und passe die Werte an:
#   cp config.py.example config.py

# Modell-Konfiguration
# hf_repo / hf_file: Falls das Modell unter 'path' fehlt, wird es automatisch
# von HuggingFace heruntergeladen (huggingface-hub muss installiert sein).
MODELS = {
    'router': {
        'path': '/models/Qwen3-4B-Q4_K_M.gguf',
        'hf_repo': 'Qwen/Qwen3-4B-GGUF',
        'hf_file': 'Qwen3-4B-Q4_K_M.gguf',
        'gpu': 1,            # GPU-Index: 1=P4
        'n_ctx': 4096,
        'n_gpu_layers': -1,  # -1 = alle Layer auf GPU
    },
    'main': {
        'path': '/models/Qwen3-8B-Q4_K_M.gguf',
        'hf_repo': 'Qwen/Qwen3-8B-GGUF',
        'hf_file': 'Qwen3-8B-Q4_K_M.gguf',
        'gpu': 0,            # GPU-Index: 0=P100
        'n_ctx': 8192,
        'n_gpu_layers': -1,
    },
}

# MySQL-Konfiguration
MYSQL = {
    'host': 'localhost',
    'port': 3306,
    'user': 'ice_brain',
    'password': 'CHANGE_ME',
    'database': 'ice_brain',
    'pool_size': 5,
}

# Server-Konfiguration
HOST = '0.0.0.0'
PORT = 8000

# Admin-Benutzername, der beim Systemstart automatisch angelegt wird (falls noch kein Admin existiert)
ADMIN_USER = 'admin'

# HuggingFace API-Token (optional, aber empfohlen für automatische Modell-Downloads).
# Wird benötigt, wenn das Modell-Repository auf HuggingFace eine Authentifizierung verlangt.
# Token erstellen unter: https://huggingface.co/settings/tokens
HF_TOKEN = ''  # z.B. 'hf_xxxxxxxxxxxxxxxxxxxx'

# Debug-Modus: Wenn True, werden alle ice_brain-Logger auf DEBUG-Level gesetzt.
# Zeigt u.a.:
#   - Router: vollständige Eingabe + Roh-Antwort des LLM
#   - Wiki-Suche: Suchbegriff, alle Treffer mit Scores, was in den Prompt eingeflossen ist
#   - Speicher-Abschnitt: ob und welche Erinnerungen in den Prompt eingebettet wurden
# Im Produktivbetrieb auf False lassen!
DEBUG_LOGGING = False

# Embedding-Modell (sentence-transformers, für Wiki-Vektorsuche)
# 'gpu': CUDA-Geräte-Index, auf dem das Modell geladen wird.
#   0 = P100  (Haupt-GPU, 16 GB – empfohlen: mehr freier Speicher)
#   1 = P4    (7.68 GB – kann bei voller GPU-Auslastung zu CUDA OOM führen)
# Entferne den 'gpu'-Schlüssel oder setze ihn auf None, um CPU zu erzwingen.
# Bei CUDA OOM fällt das Embedding-Modell automatisch auf CPU zurück.
EMBEDDING_MODEL = {
    'gpu': 0,  # P100 (16 GB) – empfohlen; P4 (gpu:1) hat zu wenig freien VRAM
}
