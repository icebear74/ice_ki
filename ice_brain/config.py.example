# ============================================================================
# Server-Konfiguration
# ============================================================================
HOST = '0.0.0.0'
PORT = 8000

# Admin-Benutzername, der beim Systemstart automatisch angelegt wird
# (falls noch kein Admin existiert)
ADMIN_USER = 'admin'

# ============================================================================
# HuggingFace API-Token (optional)
# ============================================================================
# Wird benötigt, wenn das Modell-Repository auf HuggingFace eine
# Authentifizierung verlangt (z.B. gated models).
# Token erstellen unter: https://huggingface.co/settings/tokens
HF_TOKEN = ''  # z.B. 'hf_xxxxxxxxxxxxxxxxxxxx'

# ============================================================================
# Debug-Modus
# ============================================================================
# Wenn True, werden alle ice_brain-Logger auf DEBUG-Level gesetzt.
# Zeigt u.a.:
#   - Router: vollständige Eingabe + Roh-Antwort des LLM
#   - Wiki-Suche: Suchbegriff, alle Treffer mit Scores, Prompt-Injection
#   - Speicher-Abschnitt: ob und welche Erinnerungen injiziert wurden
# Im Produktivbetrieb auf False lassen!
DEBUG_LOGGING = False

# ============================================================================
# Embedding-Modell (sentence-transformers, für Wiki-Vektorsuche)
# ============================================================================
# 'gpu': CUDA-Geräte-Index, auf dem das Modell geladen wird.
#   0 = P100  (16 GB – empfohlen, mehr freier Speicher)
#   1 = P4    (7.68 GB – kann bei voller GPU-Auslastung zu CUDA OOM führen)
# Entferne den 'gpu'-Schlüssel oder setze ihn auf None, um CPU zu erzwingen.
# Bei CUDA OOM fällt das Embedding-Modell automatisch auf CPU zurück.
EMBEDDING_MODEL = {
    'gpu': 0,  # P100 (16 GB) – empfohlen
}
