# ── Secrets – copy this file to .env.secrets and fill in your values ──────
# .env.secrets is listed in .gitignore and will NEVER be committed.
# .env.secrets.example IS committed and serves as the template.
#
# Workflow:
#   cp .env.secrets.example .env.secrets
#   nano .env.secrets   # fill in real values

# Hugging Face access token (required for pyannote models)
# Get yours at https://huggingface.co/settings/tokens
# Also accept the model license at https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=your_hf_token_here

# ── Database ───────────────────────────────────────────────────────────────
DB_USER=nexus_user
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ice_nexus_db
