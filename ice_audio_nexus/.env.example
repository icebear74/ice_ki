# Database
DB_USER=x
DB_PASSWORD=x
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ice_brain_persons
HF_TOKEN = 'xxx' 

# GPU Device IDs (optional override)
DIARIZATION_DEVICE=cuda:0
TRANSCRIPTION_DEVICE=cuda:0
DEEPFILTER_DEVICE=cuda:1
DEEPFILTER_CHUNK_SECS=60
# Video source directory (absolute path)
VIDEO_DIR=/mnt/data/videos
# TTS dataset output directory (auto-created, relative or absolute)
TTS_DATASET_DIR=/mnt/data/video/ki/voice_datasets
AUDIO_TMP_DIR=/mnt/data/video/ki/audio
VIDEO_TMP_DIR=/mnt/data/video/ki/video



# Matching thresholds for multi-vector identity
# Cosine distance < MATCH_THRESHOLD → confirmed match
MATCH_THRESHOLD=0.10
# MATCH_THRESHOLD < distance < SUGGEST_THRESHOLD → suggest adding as new vector
SUGGEST_THRESHOLD=0.30
MIN_MARGIN=0.10

# ── Diarization tuning ─────────────────────────────────────────────────────
# Minimum speaker-active duration (seconds).  Lower = detect shorter utterances.
DIARIZATION_MIN_DURATION_ON=0.5
# Minimum speaker-inactive gap (seconds) to cut a speaker turn.
DIARIZATION_MIN_DURATION_OFF=0.1
# Clustering threshold: higher = more aggressive merging of similar speakers.
# Decrease (e.g. 0.55) if two similar voices (Sheldon/Leonard) get merged.
CLUSTERING_THRESHOLD=0.5


# TTS dataset output directory (auto-created, relative or absolute)
# Struktur: TTS_DATASET_DIR/<Sprecher-Name>/<Kontext>_<start_ms>.wav  (Original)
#           TTS_DATASET_DIR/<Sprecher-Name>/<Kontext>_<start_ms>.wav.orig.wav (Sicherung)
#           TTS_DATASET_DIR/<Sprecher-Name>/<Kontext>_<start_ms>.wav.clean.wav (temporär, für Embedding)
TTS_DATASET_DIR=/mnt/data/video/ki/voice_datasets

# ── WeSpeaker speaker-embedding model ──────────────────────────────────────
# Modell-Bezeichner für wespeaker.load_model().
# Empfohlene Werte:
#   'english'  – VoxCeleb ResNet34, 256-Dim (auf 512 gepaddet) – Standard
#   'chinese'  – CNCeleb ResNet34
# Das Modell wird beim ersten Aufruf automatisch heruntergeladen und gecacht.
# Der Wert wird auch als embedding_model-Tag in der Datenbank gespeichert:
#   wespeaker-english, wespeaker-chinese, etc.
WESPEAKER_MODEL=english
# GPU für WeSpeaker (Standard: folgt DIARIZATION_DEVICE)
WESPEAKER_DEVICE=cuda:0

# ── Drift-Check ────────────────────────────────────────────────────────────
# Schwellenwert für die maximale paarweise Kosinus-Distanz zwischen den drei
# Sub-Segment-Embeddings eines Samples.  Überschreitungen deuten auf einen
# Sprecherwechsel oder ein Rauschimpuls hin → Sample wird als is_low_quality
# markiert und von der Supervektorkonstruktion ausgeschlossen.
# Typische Werte:
#   0.08 – konservativ (sehr sensitiv, viele Verwürfe)
#   0.15 – Standard (empfohlen für Produktionsbetrieb)
#   0.25 – tolerant (nur eindeutige Sprecherwechsel)
DRIFT_THRESHOLD=0.15
# Drift-Check auch beim Live-Scan aktivieren (erhöht den Rechenaufwand ~3×):
DRIFT_CHECK_ENABLED=true

# ── Matching thresholds for multi-vector identity ──────────────────────────
# Cosine distance < MATCH_THRESHOLD   → confirmed match
MATCH_THRESHOLD=0.25
# MATCH_THRESHOLD < dist < SUGGEST_THRESHOLD → suggest / needs user confirmation
SUGGEST_THRESHOLD=0.45
# Runner-up identity must be at least MIN_MARGIN further away for a confirmed match.
# Increase if Sheldon/Leonard (similar voices) collapse onto the same identity.
MIN_MARGIN=0.07

# ── Quality-filter thresholds ──────────────────────────────────────────────
# A diarization segment is flagged is_low_quality=TRUE when ANY condition hits.
# LOW_QUALITY segments are excluded from supervector clustering and voice-sample
# storage, so tuning these values directly controls dataset quality vs. quantity.
#
# LOW_QUALITY_NO_SPEECH_PROB
#   Whisper's probability that the audio contains no speech.
#   Laugh tracks, music, silence and pure noise score high here.
#   DeepFilterNet removes most of the laugh-track energy before Whisper sees the
#   audio, so 0.45 is safe even for sitcoms on cleaned audio.
#   Raise to 0.60 if real speech segments are still being over-filtered.
#
# LOW_QUALITY_MIN_DURATION_S
#   Reject segments shorter than this many seconds.
#   Drama / sitcom dialogue is often ≤ 1 s ("Okay.", "What?", "No!").
#   Old default 1.2 s discarded ~94 % of BBT segments; 0.5 s keeps short turns
#   while still rejecting single-phoneme artefacts from the diarizer.
#
# LOW_QUALITY_MIN_TRANSCRIPT_LEN
#   Reject if Whisper returns fewer characters than this.
#   3 = keep single-word answers ("No", "Hi"); 5 = discard them.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Genre examples                                                          │
# ├─────────────────────┬──────────────┬───────────────────┬───────────────┤
# │ Content             │ NO_SPEECH    │ MIN_DURATION_S    │ MIN_TRANS_LEN │
# ├─────────────────────┼──────────────┼───────────────────┼───────────────┤
# │ Sitcom (BBT, TBBT)  │ 0.45         │ 0.5               │ 3             │
# │ (laugh track, fast  │              │                   │               │
# │  dialogue)          │              │                   │               │
# ├─────────────────────┼──────────────┼───────────────────┼───────────────┤
# │ Drama (GoT, Breaking│ 0.45         │ 0.8               │ 3             │
# │ Bad) – no laugh     │              │                   │               │
# │ track, slower turns │              │                   │               │
# ├─────────────────────┼──────────────┼───────────────────┼───────────────┤
# │ Sci-Fi (Star Trek,  │ 0.45         │ 1.0               │ 5             │
# │ The Expanse) –      │              │                   │               │
# │ longer sentences,   │              │                   │               │
# │ ambient ship noise  │              │                   │               │
# ├─────────────────────┼──────────────┼───────────────────┼───────────────┤
# │ Documentary /       │ 0.35         │ 1.5               │ 8             │
# │ Audiobook – few     │              │                   │               │
# │ speakers, clean     │              │                   │               │
# └─────────────────────┴──────────────┴───────────────────┴───────────────┘
#
# Default (sitcom-safe):
LOW_QUALITY_NO_SPEECH_PROB=0.45
LOW_QUALITY_MIN_DURATION_S=0.5
LOW_QUALITY_MIN_TRANSCRIPT_LEN=3
#
# Star Trek / Sci-Fi preset (uncomment to use):
# LOW_QUALITY_NO_SPEECH_PROB=0.45
# LOW_QUALITY_MIN_DURATION_S=1.0
# LOW_QUALITY_MIN_TRANSCRIPT_LEN=5
#
# Game of Thrones / Drama preset (uncomment to use):
# LOW_QUALITY_NO_SPEECH_PROB=0.45
# LOW_QUALITY_MIN_DURATION_S=0.8
# LOW_QUALITY_MIN_TRANSCRIPT_LEN=3

