# Database
DB_USER=nexus_user
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ice_nexus_db

# Root video directory for web UI streaming allow-list
VIDEO_DIR=/data/videos

# Optional additional roots (space-separated absolute paths)
# STREAM_ALLOWED_ROOTS=/mnt/media /srv/videos

# Scanner output root (crops, representative faces, overlays)
FACE_DATA_DIR=data/faces

# Step-1A scanner defaults (sampling / run behavior)
FACE_SCAN_FPS=4.0
FACE_SCAN_START_OFFSET_SECONDS=0.0
# 0 = no hard cap
FACE_SCAN_MAX_SAMPLED_FRAMES=0
FACE_MIN_CLEAR_SECONDS=2.0
FACE_MIN_STABILITY=0.45

# Step-1A detection / quality gates
FACE_MIN_AREA_RATIO=0.06
FACE_MIN_SIZE_PX=80
FACE_MAX_ASPECT_RATIO_DEVIATION=0.65
FACE_MIN_SHARPNESS=70.0
FACE_MIN_BRIGHTNESS=40.0
FACE_MIN_QUALITY_SCORE=0.55
FACE_SEED_ACCEPTANCE_THRESHOLD=0.60
# Torch detector score threshold (legacy alias: FACE_DNN_CONFIDENCE)
FACE_DETECTOR_SCORE_THRESHOLD=0.65

# Step-1A verifier / grouping
FACE_VERIFIER_ENABLED=1
FACE_VERIFIER_SCORE_THRESHOLD=0.92
FACE_VERIFIER_MIN_AREA_RATIO=0.25
FACE_VERIFIER_MAX_CENTER_OFFSET=0.45
FACE_SEED_GROUP_SIMILARITY_THRESHOLD=0.90
# Optional alias for group assignment threshold (falls back to FACE_SEED_GROUP_SIMILARITY_THRESHOLD)
# FACE_VISUAL_GROUP_ASSIGNMENT_THRESHOLD=0.90
FACE_SEED_DUPLICATE_SIMILARITY_THRESHOLD=0.985
FACE_EXPAND_THRESHOLD=0.70

# Optional model cache override (default: ${FACE_DATA_DIR}/models)
# FACE_MODELS_DIR=data/faces/models

# Step-1A GPU / device assignment
FACE_GPU_ENABLED=1
# Legacy fallback id when FACE_*_DEVICE is unset/invalid
FACE_GPU_DEVICE_ID=0
# Component specific device mapping (cpu | cuda | cuda:<id>)
FACE_DETECTOR_DEVICE=cuda:0
FACE_VERIFIER_DEVICE=cuda:0
FACE_EMBEDDING_DEVICE=cuda:0
FACE_GPU_DIAGNOSTICS=1

# Step-1A debug / logging
FACE_SEED_DEBUG_STATS_ENABLED=0
# FACE_SEED_DEBUG_STATS_DIR=data/faces/debug/seed_runs

# Re-match defaults (post review)
FACE_REMATCH_ASSIGN_THRESHOLD=0.90
FACE_REMATCH_SUGGEST_THRESHOLD=0.78
