# ice_audio_nexus – Datenbank-Konfiguration
# Kopiere diese Datei als .env und trage deine Zugangsdaten ein.

DB_USER=ice_nexus
DB_PASSWORD=dein_passwort
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ice_nexus_db

# Optionaler HuggingFace-Token für pyannote.audio Modelle
HF_TOKEN=your_huggingface_token_here
